# IG Index API credentials
IG_API_KEY=your-api-key-here
IG_USERNAME=your-username
IG_PASSWORD=your-password
IG_ACC_TYPE=DEMO
# DEMO or LIVE — start with DEMO, always

# IG Account ID (find via GET /accounts after first login)
IG_ACCOUNT_ID=

# Supplementary data APIs (add when ready)
# FMP_API_KEY=
# ALPHA_VANTAGE_KEY=
# ORTEX_API_KEY=

# Database
DB_PATH=data/trading.db

# Logging
LOG_LEVEL=INFO
AUDIT_LOG_DIR=logs

# Risk parameters (override defaults if needed)
# MAX_RISK_PER_TRADE=0.01
# MAX_TOTAL_RISK=0.06
# MAX_SHORT_EXPOSURE=0.50
