// ════════════════════════════════════════════════════════════════
// MONEY PROGRAM — HEAD & SHOULDERS BREAKDOWN (Type S-A)
// ProOrder Automated Trading System
// ════════════════════════════════════════════════════════════════
// Short-side equivalent of the VCP breakout.
// Price breaks below neckline/breakdown level on heavy volume.
//
// Deploy: Per instrument identified by short ProScreener
// Timeframe: Daily bars
// ════════════════════════════════════════════════════════════════

DEFPARAM CumulateOrders = false
DEFPARAM PreLoadBars = 260

ONCE breakdownLevel = 0   // Set externally (neckline / breakdown point)
ONCE stopPct = 0.07       // 7% above entry
ONCE deployed = 0

// ── GATE S1: INVERSE TREND TEMPLATE ──────────────────────────
myMA50 = Average[50](close)
myMA150 = Average[150](close)
myMA200 = Average[200](close)

invTrend = close < myMA50 AND close < myMA150 AND close < myMA200
invTrend = invTrend AND myMA50 < myMA150 AND myMA150 < myMA200
invTrend = invTrend AND myMA200 < Average[200](close)[22]
invTrend = invTrend AND close <= Highest[260](high) * 0.75
invTrend = invTrend AND close <= Lowest[260](low) * 1.25

// ── GATE S2: ADX ─────────────────────────────────────────────
adxOK = ADX[14] > 25

// ── GATE S3: DISTRIBUTION ────────────────────────────────────
avgVol = Average[50](Volume)
distCount = 0
FOR i = 1 TO 10
    IF close[i] < close[i + 1] AND Volume[i] >= avgVol * 1.25 THEN
        distCount = distCount + 1
    ENDIF
NEXT
distOK = distCount >= 3

// ── ALL GATES ────────────────────────────────────────────────
allGates = invTrend AND adxOK AND distOK

// ── BREAKDOWN DETECTION ──────────────────────────────────────
breakdownVol = Volume > avgVol * 1.40
breakdown = close < breakdownLevel AND breakdownVol

// ── CHASE PROTECTION ─────────────────────────────────────────
openedTooLow = open < breakdownLevel * 0.97

// ── ENTRY ────────────────────────────────────────────────────
IF deployed = 1 AND allGates AND breakdown AND NOT openedTooLow AND NOT ONMARKET THEN
    SELLSHORT 1 CONTRACT AT MARKET
    SET STOP LOSS breakdownLevel * stopPct
ENDIF

// ── TRAILING STOP + EMERGENCY COVER ──────────────────────────
IF SHORTONMARKET THEN
    myRisk = POSITIONPRICE * stopPct
    myTarget = POSITIONPRICE - (myRisk * 3)

    // Trailing stop after 3:1 profit
    IF close <= myTarget THEN
        SET STOP TRAILING 3%
    ENDIF

    // EMERGENCY COVER: 15% adverse move — no waiting, no hoping
    IF close >= POSITIONPRICE * 1.15 THEN
        EXITSHORT AT MARKET
    ENDIF

    deployed = 0
ENDIF
